# 探针集原始 PDF 不进入 Git，只记录 source_hash（见 evals/probe/precise_clause/SPEC.md 第 2 节）
evals/probe/precise_clause/v*/sources/
evals/probe/precise_clause/v*/pages/

# Python
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.DS_Store

# Local secrets
.env
.env.*
!.env.example

# uv project artifacts (we lock with requirements.lock; run uv one-offs with --no-project)
uv.lock

# derived reviewer input packs (page texts of the gold pages; regenerate with drafts/v1/tooling/review_pack.py)
evals/probe/precise_clause/drafts/*/review/input_*.jsonl
evals/probe/precise_clause/drafts/*/review/**/input_*.jsonl
.constraints-main.tmp

# main evaluation set: source PDFs and extracted page texts never enter Git (same rule as the probe set)
evals/main_set/sources/
evals/main_set/sources_staging/
evals/main_set/pages/
# main-set drafting inputs (full page texts sent to the LLM drafter/reviewer; regenerate with evals/main_set/tools/*.py)
evals/main_set/drafts/*/inputs/
evals/main_set/drafts/*/review/input_*.jsonl
evals/main_set/drafts/*/review/**/input_*.jsonl
evals/main_set/conflict_fixtures/sources/
# friendly-name symlinks to the local PDFs (not in Git; regenerate with evals/main_set/tools/pdf_index.py)
evals/main_set/pdf_by_key/

# DEC-003 verifier pairs carry chunk text (page text derivative): local only; reports are tracked
evals/verifier/dec003/pairs.jsonl
evals/verifier/dec003/*.verdicts.jsonl
evals/verifier/dec003/*.replies/

# safety-set synthetic DOCX sources (copied licensed text + injections): regenerated by build_synthetic_docs.py
evals/safety_set/synthetic/
