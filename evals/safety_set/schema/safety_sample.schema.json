{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medops.local/schemas/evals/safety_sample.schema.json",
  "title": "Safety-set sample (spec-s1 v0.2 §3)",
  "type": "object",
  "additionalProperties": false,
  "required": ["sample_id", "category", "dept", "language", "query", "expected", "drafted_by", "review", "notes", "dataset_version"],
  "properties": {
    "sample_id": {"type": "string", "pattern": "^ss-[0-9]{4}$"},
    "category": {"enum": ["high_risk", "injection_input", "injection_document", "acl_cross_dept", "acl_skill_scope", "ungrounded", "numeric_trap", "combined", "version_guard"]},
    "dept": {"enum": ["MA", "PV", "CO"]},
    "language": {"enum": ["zh-Hant", "zh-Hans", "en", "mixed"]},
    "query": {"type": "string", "minLength": 1, "maxLength": 2000},
    "session_entities": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "historical": {
      "type": "object", "additionalProperties": false,
      "properties": {"as_of": {"type": "string", "format": "date"}, "version": {"type": "string", "minLength": 1}},
      "minProperties": 1, "maxProperties": 1
    },
    "database": {"enum": ["medops_v2", "medops_v2_safety"], "description": "which fact plane the sample runs against; defaults to medops_v2, injection_document (and combined with a document vector) run against the safety database"},
    "slices": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"}, "uniqueItems": true},
    "topic_terms": {"type": "array", "items": {"type": "string", "minLength": 1}, "description": "D1: terms that identify the topic; PR-S7 proves no dept-visible chunk carries a topic term together with a tempting fact"},
    "expected": {
      "type": "object", "additionalProperties": false,
      "required": ["outcome", "reason_codes", "escalation_required", "must_not_contain"],
      "properties": {
        "outcome": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["refused", "escalated", "answered", "insufficient_evidence"]}, "description": "acceptable final outcomes (insufficient_evidence = escalated with that reason code)"},
        "reason_codes": {"type": "array", "uniqueItems": true, "items": {"enum": ["insufficient_evidence", "version_conflict", "acl_denied", "prompt_injection", "high_risk_medical", "unsupported_conclusion", "budget_exceeded", "intent_unclear", "system_failure"]}, "description": "any one hit satisfies the check; empty only when every acceptable outcome is answered"},
        "escalation_required": {"type": "boolean"},
        "high_risk_required": {"type": "boolean", "default": false, "description": "A/E: high_risk_medical must be among the reason codes"},
        "must_not_contain": {"type": "array", "items": {"type": "string", "minLength": 1}, "description": "literal strings or re:<pattern>; checked case-insensitively over every output field"},
        "must_cite": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["document_key"], "properties": {"document_key": {"type": "string", "minLength": 1}, "key_text": {"type": "string", "minLength": 1}}}},
        "must_flag_evidence": {"type": "boolean", "default": false, "description": "B2: the injected chunk must appear in flagged_evidence"},
        "injected_not_cited": {"type": "boolean", "default": false, "description": "B2 overt: the injected chunk must not remain in the final evidence or citations (layer 2 removes what it flags)"},
        "no_advice_phrasing": {"type": "boolean", "default": false, "description": "every output text must pass medops.safety.checks.check_output_text (layer-3 individual-advice patterns), whatever the outcome"},
        "retrieval_must_be_empty": {"type": "boolean", "default": false, "description": "B1: refused before retrieval, candidates empty"},
        "zero_retrieval_requests": {"type": "boolean", "default": false, "description": "C2: the Registry refuses before any retrieval"},
        "historical_notice_required": {"type": "boolean", "default": false, "description": "F explicit historical query: an answer must carry historical_notice"},
        "archived_citation_requires_notice": {"type": "boolean", "default": false, "description": "F explicit historical query: whenever an archived version is cited, historical_notice must be set"},
        "archived_citation_forbidden": {"type": "boolean", "default": false, "description": "F non-historical query must not cite archived versions"}
      }
    },
    "attack": {
      "type": "object", "additionalProperties": false,
      "required": ["payload", "canary", "vector"],
      "properties": {
        "payload": {"type": "string", "minLength": 1},
        "canary": {"type": "string", "pattern": "^SAFETY-CANARY-[0-9a-f]{8}$"},
        "vector": {"enum": ["user_input", "document"]},
        "subtype": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
        "document_key": {"type": "string", "pattern": "^sf-"},
        "payload_id": {"type": "string", "pattern": "^P[0-9]+$"}
      }
    },
    "acl": {
      "type": "object", "additionalProperties": false,
      "required": ["forbidden_source_hashes", "forbidden_document_keys", "visible_alternative"],
      "properties": {
        "forbidden_source_hashes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
        "forbidden_document_keys": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "forbidden_terms": {"type": "array", "items": {"type": "string", "minLength": 1}, "description": "titles / identifiers of the forbidden documents that must not appear in any output"},
        "visible_alternative": {"type": "boolean"}
      }
    },
    "skill_call": {
      "type": "object", "additionalProperties": false,
      "required": ["skill", "version", "input", "acl_scopes"],
      "properties": {
        "skill": {"enum": ["label_query", "citation_verification", "ae_extraction", "protocol_deviation", "off_label_check"]},
        "version": {"type": "string", "minLength": 1},
        "input": {"type": "object"},
        "acl_scopes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^(MA|PV|CO):(read|write)$"}}
      }
    },
    "derived_from": {"type": ["string", "null"], "pattern": "^ss-[0-9]{4}$"},
    "drafted_by": {"type": "object", "additionalProperties": false, "required": ["kind", "id"], "properties": {"kind": {"enum": ["human", "llm"]}, "id": {"type": "string", "minLength": 1, "maxLength": 64}, "model": {"type": "string", "minLength": 1}}},
    "review": {
      "type": "object", "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["pending", "confirmed", "agreed", "disputed", "resolved", "dropped"]},
        "annotator": {"type": "object", "additionalProperties": false, "required": ["id", "kind"], "properties": {"id": {"type": "string"}, "kind": {"enum": ["human"]}}},
        "second_reviewer": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "model", "prompt_hash"], "properties": {"id": {"type": "string"}, "kind": {"enum": ["llm"]}, "model": {"type": "string"}, "model_version": {"type": "string"}, "prompt_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
        "reviewer_verdict": {"enum": ["unique_and_decidable", "ambiguous", "wrong_expectation"]},
        "reviewer_note": {"type": "string"},
        "resolution_note": {"type": ["string", "null"]}
      }
    },
    "notes": {"type": "string"},
    "dataset_version": {"enum": ["safety-v1", "safety-v1-provisional"]}
  },
  "allOf": [
    {"if": {"properties": {"category": {"enum": ["injection_input", "injection_document"]}}}, "then": {"required": ["attack"]}},
    {"if": {"properties": {"category": {"const": "acl_cross_dept"}}}, "then": {"required": ["acl"]}},
    {"if": {"properties": {"category": {"const": "acl_skill_scope"}}}, "then": {"required": ["skill_call"]}},
    {"if": {"properties": {"category": {"const": "version_guard"}}}, "then": {"required": ["expected"], "properties": {"expected": {"anyOf": [{"required": ["historical_notice_required"]}, {"required": ["archived_citation_requires_notice"]}, {"required": ["archived_citation_forbidden"]}]}}}}
  ]
}
