{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medy.local/evals/main_set/probe_sample.schema.json",
  "title": "MainSetSample",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sample_id",
    "query",
    "dept",
    "language",
    "slices",
    "required_gold_evidence",
    "review",
    "notes"
  ],
  "properties": {
    "sample_id": {
      "type": "string",
      "pattern": "^(pc|ms)-[0-9]{4}$"
    },
    "query": {
      "type": "string",
      "minLength": 4,
      "maxLength": 300
    },
    "dept": {
      "enum": [
        "MA",
        "PV",
        "CO"
      ]
    },
    "language": {
      "enum": [
        "zh",
        "en",
        "mixed"
      ]
    },
    "slices": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": [
          "drug_name_zh",
          "dose_unit",
          "negation",
          "time_window",
          "protocol_id",
          "mixed_zh_en",
          "version_conflict",
          "no_answer",
          "long_context"
        ]
      }
    },
    "required_gold_evidence": {
      "type": "array",
      "minItems": 0,
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/goldEvidence"
      }
    },
    "review": {
      "$ref": "#/$defs/review"
    },
    "notes": {
      "type": "string",
      "maxLength": 500
    },
    "derived_from": {
      "type": "string",
      "pattern": "^(pc|ms)-[0-9]{4}$",
      "description": "spec-v1.1: sample_id of the confirmed sample this English query twin was derived from; gold, dept and slices are inherited unchanged"
    },
    "answerable": {
      "type": "boolean",
      "description": "spec-m1: false for no-answer samples (gold empty); absent means true"
    },
    "expected_behaviour": {
      "enum": [
        "cite_evidence",
        "insufficient_evidence",
        "refuse"
      ]
    },
    "abstention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope_document_key",
        "topic",
        "absence_check"
      ],
      "properties": {
        "scope_document_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "topic": {
          "type": "string",
          "minLength": 2,
          "maxLength": 200
        },
        "absence_check": {
          "type": "string",
          "minLength": 5,
          "maxLength": 800
        },
        "document_pages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "description": "pages of the scope document packed for the LLM reviewer (reconstructed by PR-09)"
        }
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family_document_keys",
        "current_document_key",
        "clause_topic",
        "synthetic"
      ],
      "properties": {
        "family_document_keys": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "current_document_key": {
          "type": "string",
          "minLength": 1
        },
        "clause_topic": {
          "type": "string",
          "minLength": 2,
          "maxLength": 200
        },
        "synthetic": {
          "type": "boolean"
        }
      }
    },
    "drafted_by": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "human",
            "llm"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "model": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "allOf": [
          {
            "properties": {
              "slices": {
                "contains": {
                  "const": "mixed_zh_en"
                }
              }
            }
          },
          {
            "not": {
              "required": [
                "derived_from"
              ]
            }
          }
        ]
      },
      "then": {
        "properties": {
          "language": {
            "const": "mixed"
          }
        }
      },
      "$comment": "spec-v1.1: derived English twins inherit the parent's slices (PR-15) and are exempt from language=mixed"
    },
    {
      "if": {
        "properties": {
          "language": {
            "const": "en"
          }
        }
      },
      "then": {
        "properties": {
          "slices": {
            "not": {
              "contains": {
                "const": "drug_name_zh"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "answerable": {
            "const": false
          }
        },
        "required": [
          "answerable"
        ]
      },
      "then": {
        "required": [
          "expected_behaviour",
          "abstention"
        ],
        "properties": {
          "required_gold_evidence": {
            "maxItems": 0
          },
          "expected_behaviour": {
            "enum": [
              "insufficient_evidence",
              "refuse"
            ]
          },
          "slices": {
            "contains": {
              "const": "no_answer"
            }
          }
        },
        "not": {
          "required": [
            "derived_from"
          ]
        }
      },
      "else": {
        "properties": {
          "required_gold_evidence": {
            "minItems": 1
          },
          "slices": {
            "not": {
              "contains": {
                "const": "no_answer"
              }
            }
          }
        },
        "not": {
          "required": [
            "abstention"
          ]
        }
      },
      "$comment": "spec-m1 §3: no-answer samples carry no gold and no twins; answerable samples carry at least one gold"
    },
    {
      "if": {
        "properties": {
          "slices": {
            "contains": {
              "const": "version_conflict"
            }
          }
        }
      },
      "then": {
        "required": [
          "conflict"
        ]
      },
      "else": {
        "not": {
          "required": [
            "conflict"
          ]
        }
      },
      "$comment": "spec-m1 §3: the conflict block and the version_conflict slice imply each other"
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "goldEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gold_id",
        "source_hash",
        "version_label",
        "page",
        "printed_page_label",
        "section",
        "key_text",
        "evidence_span"
      ],
      "properties": {
        "gold_id": {
          "type": "string",
          "pattern": "^(pc|ms)-[0-9]{4}-g[0-9]{1,2}$"
        },
        "source_hash": {
          "$ref": "#/$defs/sha256"
        },
        "version_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "printed_page_label": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 20
        },
        "section": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "key_text": {
          "type": "string",
          "minLength": 2,
          "maxLength": 200
        },
        "evidence_span": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text",
            "char_start",
            "char_end"
          ],
          "properties": {
            "text": {
              "type": "string",
              "minLength": 2,
              "maxLength": 2000
            },
            "char_start": {
              "type": "integer",
              "minimum": 0
            },
            "char_end": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "human",
            "llm"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "model_version": {
          "type": "string",
          "minLength": 1
        },
        "prompt_hash": {
          "$ref": "#/$defs/sha256"
        }
      },
      "if": {
        "properties": {
          "kind": {
            "const": "llm"
          }
        }
      },
      "then": {
        "required": [
          "model",
          "model_version",
          "prompt_hash"
        ]
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "annotator",
        "second_reviewer",
        "status",
        "resolution_note"
      ],
      "properties": {
        "annotator": {
          "allOf": [
            {
              "$ref": "#/$defs/reviewer"
            },
            {
              "properties": {
                "kind": {
                  "const": "human"
                }
              }
            }
          ]
        },
        "second_reviewer": {
          "allOf": [
            {
              "$ref": "#/$defs/reviewer"
            },
            {
              "properties": {
                "kind": {
                  "const": "llm"
                }
              }
            }
          ]
        },
        "status": {
          "enum": [
            "agreed",
            "disputed_resolved"
          ]
        },
        "resolution_note": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000
        }
      },
      "if": {
        "properties": {
          "status": {
            "const": "disputed_resolved"
          }
        }
      },
      "then": {
        "properties": {
          "resolution_note": {
            "type": "string",
            "minLength": 5
          }
        }
      }
    }
  }
}
