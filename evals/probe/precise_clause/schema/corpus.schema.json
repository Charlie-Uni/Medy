{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medy.local/evals/probe/precise_clause/corpus.schema.json",
  "title": "PreciseClauseProbeCorpus",
  "type": "object",
  "additionalProperties": false,
  "required": ["dataset_version", "documents"],
  "properties": {
    "dataset_version": { "type": "string", "pattern": "^v[0-9]+(\\.[0-9]+)?$" },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/document" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_key", "title", "doc_type", "owner_dept", "source_url", "publisher",
        "license_or_terms", "terms_url", "retrieved_at", "version_label", "source_hash",
        "byte_size", "mime", "pages", "pii_scan", "notes"
      ],
      "properties": {
        "document_key": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 300 },
        "doc_type": { "enum": ["label", "protocol", "sop", "guideline"] },
        "owner_dept": { "enum": ["MA", "PV", "CO"] },
        "source_url": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "publisher": { "type": "string", "minLength": 1, "maxLength": 200 },
        "license_or_terms": { "type": "string", "minLength": 3, "maxLength": 300, "not": { "enum": ["未知", "unknown", "N/A", "n/a", "TBD"] } },
        "terms_url": { "type": ["string", "null"], "pattern": "^https?://" },
        "retrieved_at": { "type": "string", "format": "date" },
        "version_label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "source_hash": { "$ref": "#/$defs/sha256" },
        "byte_size": { "type": "integer", "minimum": 1 },
        "mime": { "const": "application/pdf" },
        "pages": { "type": "integer", "minimum": 1 },
        "pii_scan": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "method", "ruleset_version", "scanned_at"],
          "properties": {
            "status": { "const": "clean" },
            "method": { "type": "string", "minLength": 1 },
            "ruleset_version": { "type": "string", "minLength": 1 },
            "scanned_at": { "type": "string", "format": "date" }
          }
        },
        "notes": { "type": "string", "maxLength": 500 }
      }
    }
  }
}
