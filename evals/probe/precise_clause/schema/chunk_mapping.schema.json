{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medy.local/evals/probe/precise_clause/chunk_mapping.schema.json",
  "title": "PreciseClauseChunkMapping",
  "type": "object",
  "additionalProperties": false,
  "required": ["dataset_version", "dataset_hash", "chunker_version", "extraction", "normalization", "generated_at", "generator", "entries"],
  "properties": {
    "dataset_version": { "type": "string", "pattern": "^v[0-9]+(\\.[0-9]+)?$" },
    "dataset_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "chunker_version": { "type": "string", "minLength": 1 },
    "extraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["extractor", "extractor_version", "params_hash"],
      "properties": {
        "extractor": { "type": "string", "minLength": 1 },
        "extractor_version": { "type": "string", "minLength": 1 },
        "params_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "normalization": { "const": "norm-v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "generator": { "type": "string", "minLength": 1 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gold_id", "status", "chunk_ids", "reason"],
        "properties": {
          "gold_id": { "type": "string", "pattern": "^pc-[0-9]{4}-g[0-9]{1,2}$" },
          "status": { "enum": ["mapped", "unmappable"] },
          "chunk_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "reason": { "type": ["string", "null"], "maxLength": 500 }
        },
        "allOf": [
          { "if": { "properties": { "status": { "const": "mapped" } } }, "then": { "properties": { "chunk_ids": { "minItems": 1 } } } },
          { "if": { "properties": { "status": { "const": "unmappable" } } }, "then": { "properties": { "chunk_ids": { "maxItems": 0 }, "reason": { "type": "string", "minLength": 5 } } } }
        ]
      }
    }
  }
}
