.github
venv
.venv
__pycache__
**/__pycache__
*.pyc
.env
.env.*
!.env.example
.mypy_cache
.ruff_cache
.pytest_cache
.local
output
evals/**
!evals/glossary
!evals/glossary/glossary-*.json
evals/**/runs
evals/**/raw*
evals/**/*.pdf
evals/**/page_texts
evals/**/*.replies
evals/verifier/dec003/pairs.jsonl
docs
schemas
tests
deploy/postgres
docker-compose*.yml
Dockerfile
.dockerignore
*.md
!README.md
