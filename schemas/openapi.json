{
  "components": {
    "parameters": {
      "IdempotencyKey": {
        "description": "`Idempotency-Key` (baseline 3.2). Scope is authenticated principal + route + key; the server stores the canonical request hash. Same key and same payload returns the original receipt with the original status code, also while the first request is still processing (never 409). Same key with a different payload returns 422 `idempotency_payload_mismatch`. The record and the idempotency entry are created in one transaction. Retention is configured by IDEMPOTENCY_KEY_TTL_SECONDS (default 604800 seconds, never below 86400 seconds) and never shorter than the task lifetime.",
        "in": "header",
        "name": "Idempotency-Key",
        "required": false,
        "schema": {
          "minLength": 1,
          "type": "string"
        }
      },
      "TaskId": {
        "description": "Task identifier returned by `POST /v1/tasks`.",
        "in": "path",
        "name": "task_id",
        "required": true,
        "schema": {
          "minLength": 1,
          "type": "string"
        }
      }
    },
    "responses": {
      "Error400": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "description": "`ErrorResponse` with `code` in: `invalid_request`"
      },
      "Error401": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "description": "`ErrorResponse` with `code` in: `unauthenticated`"
      },
      "Error403": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "description": "`ErrorResponse` with `code` in: `forbidden`"
      },
      "Error404": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "description": "`ErrorResponse` with `code` in: `not_found`"
      },
      "Error409": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "description": "`ErrorResponse` with `code` in: `version_conflict`, `task_not_retryable`"
      },
      "Error422": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "description": "`ErrorResponse` with `code` in: `schema_violation`, `idempotency_payload_mismatch`"
      },
      "Error429": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "description": "`ErrorResponse` with `code` in: `rate_limited`"
      },
      "Error500": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "description": "`ErrorResponse` with `code` in: `evidence_integrity_failed`, `internal_error`"
      },
      "Error503": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "description": "`ErrorResponse` with `code` in: `dependency_unavailable`, `audit_unavailable`"
      },
      "Error504": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "description": "`ErrorResponse` with `code` in: `dependency_timeout`"
      }
    },
    "schemas": {
      "Answer": {
        "additionalProperties": false,
        "properties": {
          "citations": {
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "minItems": 1,
            "title": "Citations",
            "type": "array"
          },
          "claims": {
            "items": {
              "$ref": "#/components/schemas/Claim"
            },
            "minItems": 1,
            "title": "Claims",
            "type": "array"
          },
          "disclaimer": {
            "const": "基于文档检索，仅供专业人员参考",
            "default": "基于文档检索，仅供专业人员参考",
            "title": "Disclaimer",
            "type": "string"
          },
          "historical_notice": {
            "default": false,
            "title": "Historical Notice",
            "type": "boolean"
          }
        },
        "required": [
          "claims",
          "citations"
        ],
        "title": "Answer",
        "type": "object"
      },
      "AskRequest": {
        "additionalProperties": false,
        "properties": {
          "historical": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/HistoricalRequest"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "query": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Query",
            "type": "string"
          },
          "session_id": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Session Id"
          }
        },
        "required": [
          "query"
        ],
        "title": "AskRequest",
        "type": "object"
      },
      "AskResponse": {
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "outcome": {
                  "const": "answered"
                }
              }
            },
            "then": {
              "properties": {
                "answer": {
                  "type": "object"
                },
                "escalation": {
                  "type": "null"
                },
                "refusal": {
                  "type": "null"
                }
              },
              "required": [
                "answer"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "outcome": {
                  "const": "refused"
                }
              }
            },
            "then": {
              "properties": {
                "answer": {
                  "type": "null"
                },
                "escalation": {
                  "type": "null"
                },
                "refusal": {
                  "type": "object"
                }
              },
              "required": [
                "refusal"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "outcome": {
                  "const": "escalated"
                }
              }
            },
            "then": {
              "properties": {
                "answer": {
                  "type": "null"
                },
                "escalation": {
                  "type": "object"
                },
                "refusal": {
                  "type": "null"
                }
              },
              "required": [
                "escalation"
              ]
            }
          }
        ],
        "properties": {
          "answer": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Answer"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "escalation": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/EscalationReceipt"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "outcome": {
            "$ref": "#/components/schemas/OutcomeKind"
          },
          "refusal": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Refusal"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "trace_id": {
            "pattern": "^[0-9a-f]{32}$",
            "title": "Trace Id",
            "type": "string"
          },
          "versions": {
            "$ref": "#/components/schemas/VersionSet"
          }
        },
        "required": [
          "trace_id",
          "outcome",
          "versions"
        ],
        "title": "AskResponse",
        "type": "object"
      },
      "Citation": {
        "additionalProperties": false,
        "properties": {
          "chunk_id": {
            "minLength": 1,
            "title": "Chunk Id",
            "type": "string"
          },
          "doc_id": {
            "minLength": 1,
            "title": "Doc Id",
            "type": "string"
          },
          "effective_date": {
            "format": "date",
            "title": "Effective Date",
            "type": "string"
          },
          "page": {
            "minimum": 1,
            "title": "Page",
            "type": "integer"
          },
          "section": {
            "title": "Section",
            "type": "string"
          },
          "version": {
            "minLength": 1,
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "doc_id",
          "version",
          "effective_date",
          "page",
          "section",
          "chunk_id"
        ],
        "title": "Citation",
        "type": "object"
      },
      "Claim": {
        "additionalProperties": false,
        "properties": {
          "citation_chunk_ids": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "title": "Citation Chunk Ids",
            "type": "array"
          },
          "text": {
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text",
          "citation_chunk_ids"
        ],
        "title": "Claim",
        "type": "object"
      },
      "ErrorCode": {
        "enum": [
          "invalid_request",
          "schema_violation",
          "idempotency_payload_mismatch",
          "rate_limited",
          "unauthenticated",
          "forbidden",
          "not_found",
          "version_conflict",
          "task_not_retryable",
          "evidence_integrity_failed",
          "dependency_timeout",
          "dependency_unavailable",
          "audit_unavailable",
          "internal_error"
        ],
        "title": "ErrorCode",
        "type": "string"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "description": "Public wire format. Contains no internal detail by construction.",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "minLength": 1,
            "title": "Message",
            "type": "string"
          },
          "retryable": {
            "title": "Retryable",
            "type": "boolean"
          },
          "trace_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Trace Id"
          }
        },
        "required": [
          "code",
          "message",
          "retryable"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "EscalationReceipt": {
        "additionalProperties": false,
        "properties": {
          "escalation_id": {
            "minLength": 1,
            "title": "Escalation Id",
            "type": "string"
          },
          "message": {
            "minLength": 1,
            "title": "Message",
            "type": "string"
          },
          "reason_codes": {
            "items": {
              "$ref": "#/components/schemas/ReasonCode"
            },
            "minItems": 1,
            "title": "Reason Codes",
            "type": "array"
          }
        },
        "required": [
          "escalation_id",
          "reason_codes",
          "message"
        ],
        "title": "EscalationReceipt",
        "type": "object"
      },
      "FeedbackReceipt": {
        "additionalProperties": false,
        "properties": {
          "feedback_id": {
            "minLength": 1,
            "title": "Feedback Id",
            "type": "string"
          },
          "trace_id": {
            "pattern": "^[0-9a-f]{32}$",
            "title": "Trace Id",
            "type": "string"
          }
        },
        "required": [
          "feedback_id",
          "trace_id"
        ],
        "title": "FeedbackReceipt",
        "type": "object"
      },
      "FeedbackRequest": {
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "signal": {
                  "const": "correction"
                }
              }
            },
            "then": {
              "properties": {
                "correction_text": {
                  "type": "string"
                }
              },
              "required": [
                "correction_text"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "signal": {
                  "enum": [
                    "up",
                    "down"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "correction_text": {
                  "type": "null"
                }
              }
            }
          }
        ],
        "properties": {
          "correction_text": {
            "anyOf": [
              {
                "maxLength": 4000,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Correction Text"
          },
          "signal": {
            "$ref": "#/components/schemas/FeedbackSignal"
          },
          "trace_id": {
            "pattern": "^[0-9a-f]{32}$",
            "title": "Trace Id",
            "type": "string"
          }
        },
        "required": [
          "trace_id",
          "signal"
        ],
        "title": "FeedbackRequest",
        "type": "object"
      },
      "FeedbackSignal": {
        "enum": [
          "up",
          "down",
          "correction"
        ],
        "title": "FeedbackSignal",
        "type": "string"
      },
      "HistoricalRequest": {
        "additionalProperties": false,
        "description": "Explicit request for an archived version (INV-DATA-03); exactly one selector.",
        "oneOf": [
          {
            "properties": {
              "as_of": {
                "type": "null"
              },
              "version": {
                "type": "string"
              }
            },
            "required": [
              "version"
            ]
          },
          {
            "properties": {
              "as_of": {
                "type": "string"
              },
              "version": {
                "type": "null"
              }
            },
            "required": [
              "as_of"
            ]
          }
        ],
        "properties": {
          "as_of": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "As Of"
          },
          "version": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Version"
          }
        },
        "title": "HistoricalRequest",
        "type": "object"
      },
      "JsonValue": {},
      "OutcomeKind": {
        "enum": [
          "answered",
          "refused",
          "escalated"
        ],
        "title": "OutcomeKind",
        "type": "string"
      },
      "ReasonCode": {
        "description": "Stable refusal/escalation reason codes (baseline 5.5, F4.1).",
        "enum": [
          "insufficient_evidence",
          "version_conflict",
          "acl_denied",
          "prompt_injection",
          "high_risk_medical",
          "unsupported_conclusion",
          "budget_exceeded",
          "intent_unclear",
          "system_failure"
        ],
        "title": "ReasonCode",
        "type": "string"
      },
      "Refusal": {
        "additionalProperties": false,
        "properties": {
          "message": {
            "minLength": 1,
            "title": "Message",
            "type": "string"
          },
          "reason_codes": {
            "items": {
              "$ref": "#/components/schemas/ReasonCode"
            },
            "minItems": 1,
            "title": "Reason Codes",
            "type": "array"
          }
        },
        "required": [
          "reason_codes",
          "message"
        ],
        "title": "Refusal",
        "type": "object"
      },
      "TaskCreateRequest": {
        "additionalProperties": false,
        "description": "Skill workflow submission. `input` is validated against the skill's registered schema at\nexecution time (M2-11); the wire contract only requires a finite JSON object.",
        "properties": {
          "historical": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/HistoricalRequest"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "input": {
            "additionalProperties": {
              "$ref": "#/components/schemas/JsonValue"
            },
            "title": "Input",
            "type": "object"
          },
          "skill_name": {
            "pattern": "^[a-z][a-z0-9_]{2,63}$",
            "title": "Skill Name",
            "type": "string"
          },
          "skill_version": {
            "minLength": 1,
            "title": "Skill Version",
            "type": "string"
          }
        },
        "required": [
          "skill_name",
          "skill_version",
          "input"
        ],
        "title": "TaskCreateRequest",
        "type": "object"
      },
      "TaskResponse": {
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "completed"
                }
              }
            },
            "then": {
              "properties": {
                "error": {
                  "type": "null"
                },
                "result": {
                  "type": "object"
                }
              },
              "required": [
                "result"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "failed"
                }
              }
            },
            "then": {
              "properties": {
                "error": {
                  "type": "object"
                },
                "result": {
                  "type": "null"
                }
              },
              "required": [
                "error"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "queued",
                    "running"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "error": {
                  "type": "null"
                },
                "result": {
                  "type": "null"
                }
              }
            }
          }
        ],
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ErrorResponse"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AskResponse"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "status": {
            "$ref": "#/components/schemas/TaskStatus"
          },
          "task_id": {
            "minLength": 1,
            "title": "Task Id",
            "type": "string"
          },
          "trace_id": {
            "anyOf": [
              {
                "pattern": "^[0-9a-f]{32}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Trace Id"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "task_id",
          "status",
          "created_at",
          "updated_at"
        ],
        "title": "TaskResponse",
        "type": "object"
      },
      "TaskStatus": {
        "enum": [
          "queued",
          "running",
          "completed",
          "failed"
        ],
        "title": "TaskStatus",
        "type": "string"
      },
      "VersionSet": {
        "additionalProperties": false,
        "description": "Every version that shapes a run; recorded on each trace (INV-HAR-05) and inside operation keys.",
        "properties": {
          "model_config_version": {
            "minLength": 1,
            "title": "Model Config Version",
            "type": "string"
          },
          "policy_version": {
            "minLength": 1,
            "title": "Policy Version",
            "type": "string"
          },
          "retrieval_version": {
            "minLength": 1,
            "title": "Retrieval Version",
            "type": "string"
          },
          "skill_version_set": {
            "default": [],
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "title": "Skill Version Set",
            "type": "array"
          }
        },
        "required": [
          "policy_version",
          "retrieval_version",
          "model_config_version"
        ],
        "title": "VersionSet",
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "bearerFormat": "JWT",
        "description": "OIDC-compatible token (ADR-0001, INV-AUTH-01): the server verifies issuer, audience, expiry and signature; department and scopes are mapped server-side from `sub`, never taken from the request.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Public REST contract of MedOps Copilot (baseline 5.7). Identity always comes from the verified bearer token; request bodies never carry `dept` or `scopes`. Every error uses `ErrorResponse` (code, message, trace_id, retryable) with no internal detail. Final medical answers are never streamed before the safety check completes (INV-SAF-05). Admin document endpoints (M1), trace replay (M3-08) and policy approval (M4) are added to this document when their models exist.",
    "title": "MedOps Copilot API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/ask": {
      "post": {
        "description": "Runs the fixed `Intent -> Retrieve -> Evidence Verify -> Safety Check -> Answer / Escalate` chain. `outcome` is exactly one of answered, refused, escalated and only its own payload is present; refusals and escalations carry stable reason codes. Archived versions are only returned for an explicit `historical` selector (INV-DATA-03).",
        "operationId": "askQuestion",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AskRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AskResponse"
                }
              }
            },
            "description": "Answer, refusal or escalation for this trace."
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          },
          "409": {
            "$ref": "#/components/responses/Error409"
          },
          "422": {
            "$ref": "#/components/responses/Error422"
          },
          "429": {
            "$ref": "#/components/responses/Error429"
          },
          "500": {
            "$ref": "#/components/responses/Error500"
          },
          "503": {
            "$ref": "#/components/responses/Error503"
          },
          "504": {
            "$ref": "#/components/responses/Error504"
          }
        },
        "summary": "Synchronous question answering",
        "tags": [
          "ask"
        ]
      }
    },
    "/v1/feedback": {
      "post": {
        "description": "`correction` requires `correction_text`; `up`/`down` must not carry it. `Idempotency-Key` (baseline 3.2). Scope is authenticated principal + route + key; the server stores the canonical request hash. Same key and same payload returns the original receipt with the original status code, also while the first request is still processing (never 409). Same key with a different payload returns 422 `idempotency_payload_mismatch`. The record and the idempotency entry are created in one transaction. Retention is configured by IDEMPOTENCY_KEY_TTL_SECONDS (default 604800 seconds, never below 86400 seconds) and never shorter than the task lifetime.",
        "operationId": "submitFeedback",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "content": {
