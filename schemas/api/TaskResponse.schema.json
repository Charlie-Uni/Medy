{
  "$defs": {
    "ErrorCode": {
      "enum": [
        "invalid_request",
        "schema_violation",
        "idempotency_payload_mismatch",
        "rate_limited",
        "unauthenticated",
        "forbidden",
        "not_found",
        "version_conflict",
        "task_not_retryable",
        "status_conflict",
        "gate_not_passed",
        "policy_target_unsupported",
        "evidence_integrity_failed",
        "dependency_timeout",
        "dependency_unavailable",
        "audit_unavailable",
        "internal_error"
      ],
      "title": "ErrorCode",
      "type": "string"
    },
    "ErrorResponse": {
      "additionalProperties": false,
      "description": "Public wire format. Contains no internal detail by construction.",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "trace_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trace Id"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "title": "ErrorResponse",
      "type": "object"
    },
    "JsonValue": {},
    "ReasonCode": {
      "description": "Stable refusal/escalation reason codes (baseline 5.5, F4.1).",
      "enum": [
        "insufficient_evidence",
        "version_conflict",
        "acl_denied",
        "prompt_injection",
        "high_risk_medical",
        "unsupported_conclusion",
        "budget_exceeded",
        "intent_unclear",
        "system_failure"
      ],
      "title": "ReasonCode",
      "type": "string"
    },
    "TaskResult": {
      "additionalProperties": false,
      "description": "Result of a skill task (M3-02): the skill's typed output as it was validated against the skill's registered\noutput schema (`GET` the schema through the Registry's `describe`), plus the run status and reason codes.\nSkill outputs are structured per skill (AE elements, deviation findings, label excerpts), so they are not\nforced into the `AskResponse` shape.",
      "properties": {
        "output": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Output",
          "type": "object"
        },
        "reason_codes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ReasonCode"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "skill": {
          "minLength": 1,
          "title": "Skill",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/TaskResultStatus"
        },
        "versions": {
          "$ref": "#/$defs/VersionSet"
        }
      },
      "required": [
        "skill",
        "status",
        "output",
        "versions"
      ],
      "title": "TaskResult",
      "type": "object"
    },
    "TaskResultStatus": {
      "enum": [
        "completed",
        "insufficient_evidence",
        "escalated"
      ],
      "title": "TaskResultStatus",
      "type": "string"
    },
    "TaskStatus": {
      "enum": [
        "queued",
        "running",
        "completed",
        "failed"
      ],
      "title": "TaskStatus",
      "type": "string"
    },
    "VersionSet": {
      "additionalProperties": false,
      "description": "Every version that shapes a run; recorded on each trace (INV-HAR-05) and inside operation keys.",
      "properties": {
        "model_config_version": {
          "minLength": 1,
          "title": "Model Config Version",
          "type": "string"
        },
        "policy_version": {
          "minLength": 1,
          "title": "Policy Version",
          "type": "string"
        },
        "retrieval_version": {
          "minLength": 1,
          "title": "Retrieval Version",
          "type": "string"
        },
        "skill_version_set": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Skill Version Set",
          "type": "array"
        }
      },
      "required": [
        "policy_version",
        "retrieval_version",
        "model_config_version"
      ],
      "title": "VersionSet",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "type": "null"
          },
          "result": {
            "type": "object"
          }
        },
        "required": [
          "result"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "type": "object"
          },
          "result": {
            "type": "null"
          }
        },
        "required": [
          "error"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "queued",
              "running"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "type": "null"
          },
          "result": {
            "type": "null"
          }
        }
      }
    }
  ],
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorResponse"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "result": {
      "anyOf": [
        {
          "$ref": "#/$defs/TaskResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "status": {
      "$ref": "#/$defs/TaskStatus"
    },
    "task_id": {
      "minLength": 1,
      "title": "Task Id",
      "type": "string"
    },
    "trace_id": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{32}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Trace Id"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "task_id",
    "status",
    "created_at",
    "updated_at"
  ],
  "title": "TaskResponse",
  "type": "object"
}
