# MedOps Copilot local configuration. Copy to .env (never committed) and fill in real values.
# Every key here is read by src/medops/core/config.py; unknown keys in this file are rejected.
# Keep values plain: no quotes and no ${VAR} references, because python-dotenv and docker compose
# interpolate differently. Generate local passwords with:  python -c "import secrets; print(secrets.token_hex(16))"
# and paste the SAME value into the password key and the matching DSN below.

APP_ENV=dev                 # dev | test | prod
LOG_LEVEL=INFO              # DEBUG | INFO | WARNING | ERROR (prod forbids DEBUG)
DEBUG=false
DOCS_ENABLED=true           # must be false in prod
IDEMPOTENCY_KEY_TTL_SECONDS=604800   # Idempotency-Key retention, seconds; minimum 86400 (baseline 3.2)
RETRIEVAL_CACHE_TTL_SECONDS=300      # retrieval candidate cache TTL, seconds (1..86400); publish events invalidate earlier
# clamd for ingestion virus scans: tcp://host:3310 or unix:///var/run/clamav/clamd.ctl; empty = no scan (dev/test only, prod requires it)
CLAMD_ADDRESS=
# Local cache for the optional embedding model files (ADR-0007, `make install-embed`); empty = ~/.cache/medops-models
MODEL_CACHE_DIR=

# Compose bootstrap values (docker-compose.yml reads these)
POSTGRES_DB=medops
POSTGRES_USER=medops_admin
POSTGRES_PASSWORD=change-me-local-only
REDIS_PASSWORD=change-me-local-only

# Application connections. DATABASE_ADMIN_URL is the cluster admin used only by migrations and by the
# login-user provisioning script. DATABASE_URL should point at medops_app_user once the users below exist
# (python -m medops.infrastructure.db.login_users); before that, dev may use the admin DSN for both.
DATABASE_URL=postgresql://medops_admin:change-me-local-only@localhost:5432/medops
DATABASE_ADMIN_URL=postgresql://medops_admin:change-me-local-only@localhost:5432/medops
# Fail fast when PostgreSQL is unreachable or a statement stalls (record 78): connect timeout in seconds, per-statement
# timeout in milliseconds on every API / worker connection (must exceed the slowest legitimate statement).
DB_CONNECT_TIMEOUT_S=5
DB_STATEMENT_TIMEOUT_MS=30000
REDIS_URL=redis://:change-me-local-only@localhost:6379/0

# Passwords for the LOGIN users attached to the group roles from migration 0002 (M1-08). Generate as above.
# Leave empty until you run the provisioning script; empty means unset.
DB_APP_PASSWORD=
DB_READONLY_PASSWORD=
DB_ADMIN_PASSWORD=
DB_RESTRICTED_PASSWORD=

# Keyed pseudonymization of identities in traces/logs (INV-OBS-02); required in prod. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
IDENTITY_PSEUDONYM_KEY=

# Runtime LLM provider (ADR-0010 / DEC-009): create the key at platform.openai.com with a monthly usage limit
# matching LLM_MONTHLY_BUDGET_USD (decision 2026-09-23: 30 USD, adjustable). Empty means unset (runtime disabled).
OPENAI_API_KEY=
LLM_MONTHLY_BUDGET_USD=30

# Deferred until their decisions: OIDC issuer/audience (DEC-010), object storage (DEC-007).
# Do not add keys here before the ADR exists.

# Identity boundary (ADR-0001, M3-05): issuer and audience the API accepts; the trusted JWK set as JSON;
# optional IdP-group -> scopes allowlist as JSON ({"group": ["PV:read"]}). Dev/test use the synthetic issuer.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_JSON=
OIDC_JWKS_URL=
OIDC_GROUP_SCOPES_JSON=

# Read-only LOGIN user for the MCP server (INV-AUTH-04); same database, medops_readonly group role.
DATABASE_READONLY_URL=

# Container DSNs (docker compose --profile app): same credentials, service hostnames postgres/redis.
# Unset -> the host values above are used, which only works with host networking.
DATABASE_URL_DOCKER=
DATABASE_ADMIN_URL_DOCKER=
DATABASE_READONLY_URL_DOCKER=
REDIS_URL_DOCKER=

# Telemetry (M3-09): OTLP/HTTP collector base URL; unset disables span export.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=medops-copilot

# Restricted replay payloads (DEC-013): JSON key file {"current": "k1", "keys": {"k1": "<base64 32 bytes>"}}, mode 0600,
# injected at deployment (never a .env value). Unset = payloads are not written. The reader / retention job connects as
# medops_restricted_user (DATABASE_RESTRICTED_URL).
PAYLOAD_KEY_FILE=
DATABASE_RESTRICTED_URL=
PAYLOAD_RETENTION_DAYS=90
ESCALATION_PAYLOAD_GRACE_DAYS=30
