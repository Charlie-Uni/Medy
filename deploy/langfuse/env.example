# Generated local values live in deploy/langfuse/.env (mode 0600, ignored by Git).
# Run `make langfuse-init`; do not copy these placeholders into a running deployment.
LANGFUSE_POSTGRES_USER=langfuse
LANGFUSE_POSTGRES_PASSWORD=generate-a-random-value
LANGFUSE_POSTGRES_DB=langfuse
LANGFUSE_SALT=generate-a-random-value
LANGFUSE_ENCRYPTION_KEY=generate-64-hex-characters
LANGFUSE_NEXTAUTH_SECRET=generate-a-random-value
LANGFUSE_CLICKHOUSE_USER=clickhouse
LANGFUSE_CLICKHOUSE_PASSWORD=generate-a-random-value
LANGFUSE_REDIS_PASSWORD=generate-a-random-value
LANGFUSE_MINIO_USER=minio
LANGFUSE_MINIO_PASSWORD=generate-a-random-value
LANGFUSE_INIT_ORG_ID=generate-a-uuid
LANGFUSE_INIT_PROJECT_ID=generate-a-uuid
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-generate-a-random-value
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-generate-a-random-value
LANGFUSE_INIT_USER_EMAIL=admin@medy.local
LANGFUSE_INIT_USER_PASSWORD=generate-a-random-value
